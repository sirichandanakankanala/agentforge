import { useEffect, useState } from "react";
import "./App.css";

function App() {
  const [userRequest, setUserRequest] = useState("");
  const [result, setResult] = useState(null);
  const [savedAgents, setSavedAgents] = useState([]);
  const [loading, setLoading] = useState(false);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");

  const API_BASE_URL = "http://127.0.0.1:8000";

  const fetchSavedAgents = async () => {
    try {
      const response = await fetch(`${API_BASE_URL}/agents`);
      const data = await response.json();
      setSavedAgents(data.agents || []);
    } catch (err) {
      console.error("Failed to fetch saved agents:", err);
    }
  };

  const generateAgent = async () => {
    if (!userRequest.trim()) {
      setError("Please enter an agent idea.");
      return;
    }

    setLoading(true);
    setError("");
    setResult(null);

    try {
      const response = await fetch(`${API_BASE_URL}/agents/generate`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
          user_request: userRequest,
        }),
      });

      if (!response.ok) {
        throw new Error("Backend request failed.");
      }

      const data = await response.json();
      setResult(data);
    } catch (err) {
      console.error(err);
      setError("Could not connect to backend. Make sure backend is running on port 8000.");
    } finally {
      setLoading(false);
    }
  };

  const saveAgent = async () => {
    if (!result) {
      setError("Generate an agent before saving.");
      return;
    }

    setSaving(true);
    setError("");

    try {
      const response = await fetch(`${API_BASE_URL}/agents/save`, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(result),
      });

      if (!response.ok) {
        throw new Error("Save request failed.");
      }

      await fetchSavedAgents();
      alert("Agent saved successfully.");
    } catch (err) {
      console.error(err);
      setError("Could not save agent.");
    } finally {
      setSaving(false);
    }
  };

  useEffect(() => {
    fetchSavedAgents();
  }, []);

  return (
    <div className="app">
      <header className="header">
        <p className="badge">AgentForge</p>
        <h1>Generate Specialized AI Agent Blueprints</h1>
        <p className="subtitle">
          Describe a goal, generate an agent blueprint, save it, and view it in your Agent Library.
        </p>
      </header>

      <main className="layout">
        <section className="panel generator-panel">
          <h2>Generate Agent</h2>

          <textarea
            value={userRequest}
            onChange={(e) => setUserRequest(e.target.value)}
            placeholder="Example: Create an agent that sends me daily AI news alerts"
            rows={5}
          />

          <button onClick={generateAgent} disabled={loading}>
            {loading ? "Generating..." : "Generate Agent"}
          </button>

          {error && <p className="error">{error}</p>}
        </section>

        {result && (
          <section className="panel result-panel">
            <div className="section-title-row">
              <h2>Generated Agent Blueprint</h2>
              <button className="secondary-button" onClick={saveAgent} disabled={saving}>
                {saving ? "Saving..." : "Save Agent"}
              </button>
            </div>

            <div className="grid">
              <div>
                <h3>Goal</h3>
                <p>{result.goal}</p>
              </div>

              <div>
                <h3>Frequency</h3>
                <p>{result.frequency}</p>
              </div>

              <div>
                <h3>Output Type</h3>
                <p>{result.output_type}</p>
              </div>

              <div>
                <h3>Mode</h3>
                <p>{result.mode === "true" ? "Mock Mode" : result.mode}</p>
              </div>
            </div>

            <h3>Tools Needed</h3>
            <ul className="tool-list">
              {result.tools_needed.map((tool, index) => (
                <li key={index}>{tool}</li>
              ))}
            </ul>

            <h3>System Prompt</h3>
            <pre>{result.system_prompt}</pre>

            <h3>Workflow Steps</h3>
            <pre>{JSON.stringify(result.workflow_steps, null, 2)}</pre>

            <h3>Memory Configuration</h3>
            <pre>{JSON.stringify(result.memory_config, null, 2)}</pre>

            <h3>Validation</h3>
            <pre>{JSON.stringify(result.validation_result, null, 2)}</pre>
          </section>
        )}

        <section className="panel library-panel">
          <div className="section-title-row">
            <h2>Saved Agent Library</h2>
            <button className="secondary-button" onClick={fetchSavedAgents}>
              Refresh
            </button>
          </div>

          {savedAgents.length === 0 ? (
            <p className="empty-state">No saved agents yet. Generate an agent and click Save Agent.</p>
          ) : (
            <div className="saved-list">
              {savedAgents.map((item) => (
                <article key={item.id} className="saved-card">
                  <h3>{item.agent.goal || "Untitled Agent"}</h3>
                  <p>
                    <strong>Created:</strong>{" "}
                    {new Date(item.created_at).toLocaleString()}
                  </p>
                  <p>
                    <strong>Frequency:</strong> {item.agent.frequency}
                  </p>
                  <p>
                    <strong>Output:</strong> {item.agent.output_type}
                  </p>
                  <details>
                    <summary>View full blueprint</summary>
                    <pre>{JSON.stringify(item.agent, null, 2)}</pre>
                  </details>
                </article>
              ))}
            </div>
          )}
        </section>
      </main>
    </div>
  );
}

export default App;
