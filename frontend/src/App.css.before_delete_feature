* {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  background: #0f172a;
  color: #e5e7eb;
}

button,
textarea {
  font: inherit;
}

.app {
  min-height: 100vh;
  padding: 40px 20px;
}

.header {
  max-width: 1100px;
  margin: 0 auto 32px;
  text-align: center;
}

.badge {
  display: inline-block;
  margin: 0 0 12px;
  padding: 8px 14px;
  border: 1px solid #334155;
  border-radius: 999px;
  color: #93c5fd;
  background: rgba(30, 64, 175, 0.2);
  font-weight: 700;
}

h1 {
  margin: 0;
  font-size: clamp(34px, 6vw, 64px);
  line-height: 1;
  letter-spacing: -0.05em;
}

.subtitle {
  max-width: 760px;
  margin: 18px auto 0;
  color: #94a3b8;
  font-size: 18px;
}

.layout {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  gap: 22px;
}

.panel {
  background: #111827;
  border: 1px solid #243244;
  border-radius: 24px;
  padding: 24px;
  box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
}

.panel h2 {
  margin: 0 0 16px;
  font-size: 24px;
}

.panel h3 {
  margin: 22px 0 8px;
  color: #bfdbfe;
}

textarea {
  width: 100%;
  resize: vertical;
  border: 1px solid #334155;
  border-radius: 16px;
  padding: 16px;
  background: #020617;
  color: #e5e7eb;
  outline: none;
}

textarea:focus {
  border-color: #60a5fa;
}

button {
  margin-top: 14px;
  border: none;
  border-radius: 14px;
  padding: 12px 18px;
  background: #2563eb;
  color: white;
  font-weight: 700;
  cursor: pointer;
}

button:hover {
  background: #1d4ed8;
}

button:disabled {
  opacity: 0.65;
  cursor: not-allowed;
}

.secondary-button {
  margin-top: 0;
  background: #334155;
}

.secondary-button:hover {
  background: #475569;
}

.error {
  color: #fecaca;
  background: rgba(220, 38, 38, 0.15);
  border: 1px solid rgba(248, 113, 113, 0.35);
  border-radius: 14px;
  padding: 12px;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  flex-wrap: wrap;
}

.grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
}

.grid > div {
  background: #020617;
  border: 1px solid #1e293b;
  border-radius: 18px;
  padding: 16px;
}

.grid h3 {
  margin-top: 0;
}

.tool-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  padding: 0;
  list-style: none;
}

.tool-list li {
  padding: 8px 12px;
  background: rgba(37, 99, 235, 0.2);
  color: #bfdbfe;
  border: 1px solid rgba(96, 165, 250, 0.25);
  border-radius: 999px;
}

pre {
  white-space: pre-wrap;
  word-break: break-word;
  overflow-x: auto;
  background: #020617;
  border: 1px solid #1e293b;
  border-radius: 18px;
  padding: 16px;
  color: #d1d5db;
}

.empty-state {
  color: #94a3b8;
}

.saved-list {
  display: grid;
  gap: 16px;
}

.saved-card {
  background: #020617;
  border: 1px solid #1e293b;
  border-radius: 18px;
  padding: 18px;
}

.saved-card h3 {
  margin-top: 0;
}

summary {
  cursor: pointer;
  color: #93c5fd;
  font-weight: 700;
}

@media (max-width: 900px) {
  .grid {
    grid-template-columns: 1fr 1fr;
  }
}

@media (max-width: 640px) {
  .app {
    padding: 24px 14px;
  }

  .grid {
    grid-template-columns: 1fr;
  }
}
